    "import statistics\n",
    "\n",
    "# liste de nombres\n",
    "\n",
    "data = [10, 20, 30, 40, 50]\n",
    "\n",
    "# calcul de la moyenne\n",
    "mean = statistics.mean(data)\n",
    "print(f\"la moyenne est : {mean}\")\n",
    "\n",
    "# calcul de l'ecart type\n",
    "std_dev = statistics.stdev(data)\n",
    "print(f\"L'ecart type est : {std_dev}\")"
   ]
  }
 ],
